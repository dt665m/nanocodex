{
  "name": "nanocodex-egress-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run prepare:whatsapp && vitest run && node --experimental-strip-types --test test/mercator-payment.node.test.mjs test/chatgpt-failover-journey.test.mjs && npm run test:whatsapp",
    "dry-run:agent": "wrangler deploy --dry-run --config wrangler.agent.jsonc",
    "deploy:agent": "wrangler deploy --config wrangler.agent.jsonc",
    "dry-run:broker": "wrangler deploy --dry-run --config wrangler.broker.jsonc",
    "deploy:broker": "wrangler deploy --env=\"\" --config wrangler.broker.jsonc",
    "prepare:whatsapp": "node scripts/prepare-whatsapp.mjs",
    "test:whatsapp-runtime": "node test/whatsapp-runtime/run.mjs",
    "test:whatsapp": "node --test test/whatsapp-account.node.test.mjs test/whatsapp-broker.node.test.mjs && npm run test:whatsapp-runtime"
  },
  "dependencies": {
    "accounts": "0.17.0",
    "mppx": "0.11.0",
    "nanocodex": "workspace:*",
    "viem": "^2.54.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "whatsapp-rust-bridge": "0.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "4.127.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20260828.0-alpha",
    "ws": "8.21.0"
  }
}
